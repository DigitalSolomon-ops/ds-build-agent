# solomon-runner — ds-build-agent as a Cloud Run Job for The Creator.
# Build context = this repo. git is required for commit_after_each_task; tar
# archives the finished workspace to GCS (see cloud-job.ts). Python 3.12 and
# the Google Cloud CLI let the runner build Python plans (e.g. Streamlit apps)
# and deploy them to GCP natively, alongside the original Node/TS build path.
FROM node:24-slim

# System tooling. git: per-task commits. tar: workspace archival. curl/gnupg/
# apt-transport-https: add the Google Cloud apt repo in the next layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates tar curl gnupg apt-transport-https \
  && rm -rf /var/lib/apt/lists/*

# Google Cloud CLI (gcloud) — plans deploy with `gcloud storage cp`,
# `gcloud builds submit`, and `gcloud run deploy`. Authentication comes from the
# job's service account via the metadata server at runtime (no key is baked in).
RUN curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
      | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
      > /etc/apt/sources.list.d/google-cloud-sdk.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends google-cloud-cli \
  && rm -rf /var/lib/apt/lists/*

# Python 3.12 via uv (python-build-standalone): the exact version regardless of
# the Debian base, and `python3 -m venv` / `pip install` work out of the box
# (python-build-standalone is not marked PEP-668 externally-managed, so the
# agent's venv + pip flow never hits Debian's install wall). Exposed as the
# default python / python3 on PATH; gcloud keeps its own bundled interpreter.
ENV UV_PYTHON_INSTALL_DIR=/opt/python
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv python install 3.12 \
  && ln -sf "$(uv python find 3.12)" /usr/local/bin/python3 \
  && ln -sf /usr/local/bin/python3 /usr/local/bin/python \
  && python3 --version \
  && python3 -m venv /tmp/_venvcheck && rm -rf /tmp/_venvcheck

WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY src ./src
RUN npx tsc
ENV NODE_ENV=production
# /workspace is the ephemeral build area for the plan's app repo.
RUN mkdir -p /workspace
CMD ["node", "dist/cloud-job.js"]
